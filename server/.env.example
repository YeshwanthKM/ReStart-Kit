PORT=5001
NODE_ENV=development

# Database connection URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restartkit?schema=public"

# JWT Auth secret key
JWT_SECRET="restart_kit_jwt_super_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"
